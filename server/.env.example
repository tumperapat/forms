DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-production"
PORT=4001

# Where the client app runs, for OAuth redirects back after connecting Google Sheets.
CLIENT_URL="http://localhost:5174"

# Google Sheets export (optional). Create an OAuth 2.0 Client ID (type: Web application)
# in Google Cloud Console, enable the Google Sheets API, and add
# GOOGLE_REDIRECT_URI as an authorized redirect URI on that client.
# Leave these unset to disable Google Sheets sync — Excel export always works.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4001/api/sheets/oauth/callback"
